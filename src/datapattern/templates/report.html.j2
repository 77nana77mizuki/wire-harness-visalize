<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ addon.name }} — データパターン</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #ffffff; --fg: #1a1a1a; --muted: #5b5b5b;
  --border: #d8d8d8; --panel: #f6f6f6; --accent: #0b5cad;
  --badge-option: #7a4dd6; --badge-circuit: #0a7d55; --badge-property: #b5560a;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #17191c; --fg: #e8e8e8; --muted: #a0a0a0;
    --border: #3a3d42; --panel: #1f2226; --accent: #5aa9f0;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 2rem 1.25rem 4rem;
  background: var(--bg); color: var(--fg);
  font: 15px/1.6 system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
}
main { max-width: 1000px; margin: 0 auto; }
h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
h2 { font-size: 1.2rem; margin: 2.6rem 0 .6rem; padding-bottom: .3rem; border-bottom: 2px solid var(--border); }
h3 { font-size: 1.05rem; margin: 0 0 .5rem; scroll-margin-top: 1rem; }
.sub { color: var(--muted); margin: 0 0 1.2rem; }
a { color: var(--accent); }
code { background: var(--panel); padding: .1rem .35rem; border-radius: 3px; font-size: .9em; }

table.grid { border-collapse: collapse; width: 100%; margin: .4rem 0 1rem; font-size: .92rem; }
table.grid th, table.grid td { border: 1px solid var(--border); padding: .4rem .6rem; text-align: left; vertical-align: top; }
table.grid thead th { background: var(--panel); position: sticky; top: 0; }
table.grid tbody th { background: var(--panel); white-space: nowrap; width: 1%; color: var(--muted); font-weight: 600; }
.dp-empty { color: var(--muted); }
ul.tight { margin: .1rem 0; padding-left: 1.2rem; }
ul.tight li { margin: .1rem 0; }

.badge { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .02em;
  color: #fff; padding: .08rem .5rem; border-radius: 999px; white-space: nowrap; }
.badge.option_config { background: var(--badge-option); }
.badge.circuit { background: var(--badge-circuit); }
.badge.property_set { background: var(--badge-property); }

section.pattern { margin: 1.6rem 0; padding-top: .6rem; border-top: 1px dashed var(--border); }
section.pattern:first-of-type { border-top: none; }

/* --- 図: 実現方式タブ（純 CSS。radio + :checked ~ sibling） --- */
.figtabs { margin: .6rem 0 0; position: relative; }
.figtabs > input.tabradio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.tablist { display: flex; flex-wrap: wrap; gap: .25rem; margin-bottom: -1px; }
.tablist > label { font-size: .82rem; padding: .3rem .8rem; cursor: pointer;
  background: var(--panel); color: var(--muted);
  border: 1px solid var(--border); border-bottom: none;
  border-radius: 5px 5px 0 0; user-select: none; }
.panels > .figpanel { display: none; border: 1px solid var(--border); border-radius: 0 5px 5px 5px;
  padding: .8rem; overflow-x: auto; }
.figpanel .method-tag { display: none; }
.svg-wrap svg { background: #ffffff; border-radius: 4px; max-width: 100%; height: auto; display: block; }
/* radio N が checked → パネル N を表示 / ラベル N をアクティブ表示（最大 6 方式） */
.figtabs > input.tabradio:nth-of-type(1):checked ~ .panels > .figpanel:nth-child(1),
.figtabs > input.tabradio:nth-of-type(2):checked ~ .panels > .figpanel:nth-child(2),
.figtabs > input.tabradio:nth-of-type(3):checked ~ .panels > .figpanel:nth-child(3),
.figtabs > input.tabradio:nth-of-type(4):checked ~ .panels > .figpanel:nth-child(4),
.figtabs > input.tabradio:nth-of-type(5):checked ~ .panels > .figpanel:nth-child(5),
.figtabs > input.tabradio:nth-of-type(6):checked ~ .panels > .figpanel:nth-child(6) { display: block; }
.figtabs > input.tabradio:nth-of-type(1):checked ~ .tablist > label:nth-child(1),
.figtabs > input.tabradio:nth-of-type(2):checked ~ .tablist > label:nth-child(2),
.figtabs > input.tabradio:nth-of-type(3):checked ~ .tablist > label:nth-child(3),
.figtabs > input.tabradio:nth-of-type(4):checked ~ .tablist > label:nth-child(4),
.figtabs > input.tabradio:nth-of-type(5):checked ~ .tablist > label:nth-child(5),
.figtabs > input.tabradio:nth-of-type(6):checked ~ .tablist > label:nth-child(6) {
  background: var(--bg); color: var(--fg); font-weight: 600; }
.figtabs > input.tabradio:focus-visible ~ .tablist > label { outline: 2px solid var(--accent); }

footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .82rem; }

@media print {
  body { padding: 0; font-size: 10.5pt; }
  h2, h3 { break-after: avoid; }
  section.pattern { break-inside: avoid; }
  table.grid thead th { position: static; }
  .tablist { display: none; }
  .panels > .figpanel { display: block !important; break-inside: avoid; border-radius: 5px; margin-top: .4rem; }
  .figpanel .method-tag { display: block; font-size: .75rem; color: var(--muted); margin-bottom: .3rem; }
}
</style>
</head>
<body>
<main>
<h1>{{ addon.name }}</h1>
<p class="sub">
  テスト用データパターン {{ patterns|length }} 件
  / プラグイン種別: <strong>{{ addon.plugin_type }}</strong>
  {%- if addon.capital_version %} / Capital {{ addon.capital_version }}{% endif %}
  {%- if methods_used %} / 描画方式: {{ methods_used|join(", ") }}{% endif %}
</p>

<h2>分類サマリ</h2>
<table class="grid">
  <thead><tr><th>分類</th><th style="text-align:right">件数</th><th>説明</th></tr></thead>
  <tbody>
  {%- for row in type_summary %}
    <tr>
      <td><span class="badge {{ row.type }}">{{ row.type }}</span></td>
      <td style="text-align:right">{{ row.count }}</td>
      <td>{{ row.label }}</td>
    </tr>
  {%- endfor %}
  </tbody>
</table>

<h2>パターン一覧</h2>
<table class="grid">
  <thead><tr><th>ID</th><th>分類</th><th>タイトル</th><th>概要</th><th>描画方式</th></tr></thead>
  <tbody>
  {%- for row in overview %}
    <tr>
      <td><a href="#{{ row.id }}"><code>{{ row.id }}</code></a></td>
      <td><span class="badge {{ row.type }}">{{ row.type }}</span></td>
      <td>{{ row.title }}</td>
      <td>{{ row.summary }}</td>
      <td>{{ row.methods }}</td>
    </tr>
  {%- endfor %}
  </tbody>
</table>

<h2>パターン詳細</h2>
{%- for p in patterns %}
<section class="pattern" id="{{ p.id }}">
  <h3>{{ p.title }} <span class="badge {{ p.type }}">{{ p.type }}</span></h3>
  <table class="grid">
    <tbody>
      <tr><th>ID</th><td><code>{{ p.id }}</code></td></tr>
      <tr><th>概要</th><td>{{ p.summary }}</td></tr>
      <tr><th>なぜ必要か</th><td>{{ p.rationale }}</td></tr>
      {%- if p.option_expression %}
      <tr><th>option 式</th><td><code>{{ p.option_expression }}</code></td></tr>
      {%- endif %}
      {%- if p.test_hints %}
      <tr><th>テストのヒント</th><td><ul class="tight">
        {%- for h in p.test_hints %}<li>{{ h }}</li>{% endfor %}
      </ul></td></tr>
      {%- endif %}
      {%- if p.source_refs %}
      <tr><th>根拠</th><td>
        {%- for r in p.source_refs %}<code>{{ r }}</code>{% if not loop.last %}<br>{% endif %}{% endfor %}
      </td></tr>
      {%- endif %}
    </tbody>
  </table>

  {%- set figs = figures[p.id] %}
  {%- if figs %}
  <div class="figtabs">
    {%- for f in figs %}
    <input class="tabradio" type="radio" name="tabs-{{ p.id }}" id="tab-{{ p.id }}-{{ loop.index0 }}"{% if loop.first %} checked{% endif %}>
    {%- endfor %}
    <div class="tablist">
      {%- for f in figs %}
      <label for="tab-{{ p.id }}-{{ loop.index0 }}">{{ f.method }}</label>
      {%- endfor %}
    </div>
    <div class="panels">
      {%- for f in figs %}
      <div class="figpanel">
        <div class="method-tag">{{ f.method }}</div>
        {{ f.content | safe }}
      </div>
      {%- endfor %}
    </div>
  </div>
  {%- else %}
  <p class="dp-empty">利用可能なレンダラで描画できませんでした。</p>
  {%- endif %}
</section>
{%- endfor %}

<footer>
  DataPatternModel v{{ schema_version }}
  {%- if generator %} / 生成: {{ generator }}{% endif %}
  {%- if skipped %} / 描画不可: {{ skipped|join(", ") }}{% endif %}
</footer>
</main>
</body>
</html>
